<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Discord Self-Bot Voice Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      background-color: #0a0714;
      color: #e2e8f0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .purple-glass {
      background: rgba(23, 15, 38, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(147, 51, 234, 0.2);
    }
    .purple-glass-hover:hover {
      background: rgba(35, 21, 60, 0.8);
      border-color: rgba(168, 85, 247, 0.4);
    }
    .purple-glow {
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.35);
    }
    .purple-glow-btn:hover {
      box-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0f0a1c;
    }
    ::-webkit-scrollbar-thumb {
      background: #6b21a8;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #9333ea;
    }
    input[type=range] {
      accent-color: #a855f7;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-purple-600 selection:text-white">

  <!-- LOGIN OVERLAY -->
  <div id="loginModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4">
    <div class="purple-glass purple-glow w-full max-w-md p-8 rounded-2xl border border-purple-500/30 text-center">
      <div class="w-16 h-16 bg-purple-900/50 rounded-full flex items-center justify-center mx-auto mb-4 border border-purple-500/50">
        <i class="fa-solid fa-headset text-3xl text-purple-400"></i>
      </div>
      <h2 class="text-2xl font-bold text-white mb-1">Self-Bot Voice Dashboard</h2>
      <p class="text-sm text-purple-300/70 mb-6">Bulk VC Control Panel</p>
      
      <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4 text-left">
        <div>
          <label class="text-xs font-semibold uppercase text-purple-300">Username</label>
          <input type="text" id="usernameInput" required placeholder="DINESH or HUKUM" 
            class="w-full mt-1 px-4 py-2.5 bg-black/50 border border-purple-900 focus:border-purple-500 rounded-xl text-white outline-none transition">
        </div>
        <div>
          <label class="text-xs font-semibold uppercase text-purple-300">Password</label>
          <input type="password" id="passwordInput" required placeholder="••••••••" 
            class="w-full mt-1 px-4 py-2.5 bg-black/50 border border-purple-900 focus:border-purple-500 rounded-xl text-white outline-none transition">
        </div>
        <p id="loginError" class="text-xs text-red-400 hidden"><i class="fa-solid fa-triangle-exclamation"></i> Invalid credentials!</p>

        <button type="submit" class="w-full py-3 bg-gradient-to-r from-purple-700 to-indigo-600 hover:from-purple-600 hover:to-indigo-500 font-bold rounded-xl text-white purple-glow-btn transition transform active:scale-95 mt-2">
          <i class="fa-solid fa-right-to-bracket mr-2"></i> LOGIN
        </button>
      </form>
      
      <div class="mt-6 text-xs text-purple-400/60 bg-purple-950/40 p-3 rounded-lg border border-purple-900/40 text-left space-y-1">
        <div><strong>User Login:</strong> DINESH / DINESH</div>
        <div><strong>Admin Login:</strong> HUKUM / HUKUM1433</div>
      </div>
    </div>
  </div>

  <!-- MAIN APP CONTAINER -->
  <div id="appContainer" class="hidden flex-col min-h-screen">
    
    <!-- NAVBAR -->
    <header class="purple-glass border-b border-purple-900/40 sticky top-0 z-40 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-purple-600/30 flex items-center justify-center border border-purple-500/40">
          <i class="fa-solid fa-bolt text-purple-400 text-xl"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-purple-400 via-purple-200 to-indigo-300 bg-clip-text text-transparent">
            SelfBot VC Master <span class="text-xs px-2 py-0.5 rounded bg-purple-900/80 text-purple-300 border border-purple-600/40">v2.0</span>
          </h1>
          <p class="text-xs text-purple-400/70">Web Token Control Hub</p>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div class="text-right hidden sm:block">
          <div id="currentUserDisplay" class="text-sm font-semibold text-white">DINESH</div>
          <div id="currentRoleDisplay" class="text-xs text-purple-400">User Account</div>
        </div>
        <button onclick="handleLogout()" class="px-3 py-1.5 text-xs bg-red-950/60 hover:bg-red-900/80 border border-red-700/50 text-red-300 rounded-lg transition flex items-center gap-1.5">
          <i class="fa-solid fa-power-off"></i> Logout
        </button>
      </div>
    </header>

    <!-- ADMIN PANEL ALERT -->
    <div id="adminBanner" class="hidden bg-purple-950/70 border-b border-purple-600/40 px-6 py-2 text-xs text-purple-200 flex justify-between items-center">
      <span><i class="fa-solid fa-shield-halved text-purple-400 mr-2"></i> <strong>ADMIN MODE ACTIVATED (HUKUM)</strong> - Full System Permissions Granted.</span>
      <span class="bg-purple-800/60 px-2 py-0.5 rounded text-[10px] text-purple-100">Super User</span>
    </div>

    <!-- CONTENT GRID -->
    <main class="p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 max-w-7xl mx-auto w-full">
      
      <!-- LEFT COLUMN: TOKENS & SERVERS -->
      <section class="lg:col-span-5 space-y-6">
        
        <!-- TOKEN MANAGEMENT CARD -->
        <div class="purple-glass rounded-2xl p-5 border border-purple-900/40 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-key text-purple-400"></i> Bot Tokens (<span id="tokenCount">0</span>)
            </h2>
            <button onclick="toggleBulkModal()" class="text-xs bg-purple-800/50 hover:bg-purple-700/60 text-purple-200 px-3 py-1.5 rounded-lg border border-purple-500/40 transition">
              <i class="fa-solid fa-plus-minus mr-1"></i> Bulk Add
            </button>
          </div>

          <!-- Single Token Input -->
          <div class="space-y-2">
            <div class="flex gap-2">
              <input type="password" id="singleTokenInput" placeholder="Paste Discord Self Bot Token" 
                class="flex-1 bg-black/50 border border-purple-900/60 focus:border-purple-500 rounded-xl px-3 py-2 text-xs outline-none text-purple-200">
              <button onclick="addSingleToken()" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-semibold transition">
                Add
              </button>
            </div>
          </div>

          <!-- Tokens List -->
          <div class="max-h-48 overflow-y-auto space-y-2 pr-1" id="tokenList">
            <div class="text-center py-6 text-xs text-purple-400/50 italic">No tokens added yet. Paste tokens above.</div>
          </div>
        </div>

        <!-- SERVER & VOICE CHANNELS CARD -->
        <div class="purple-glass rounded-2xl p-5 border border-purple-900/40 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-server text-purple-400"></i> Active Servers & VCs
          </h2>

          <div class="space-y-3">
            <label class="text-xs text-purple-300">Select Target Server</label>
            <select id="serverSelect" onchange="onServerChange()" class="w-full bg-black/60 border border-purple-900 focus:border-purple-500 rounded-xl px-3 py-2 text-xs text-purple-200 outline-none">
              <option value="">-- Choose Server --</option>
              <option value="s1">Telugu Gaming Warriors (GUILD_883021)</option>
              <option value="s2">Hyderabad Vibe Lounge (GUILD_110293)</option>
              <option value="s3">Mass Beats Music Club (GUILD_992104)</option>
            </select>
          </div>

          <!-- Voice Channels List -->
          <div class="space-y-2">
            <label class="text-xs text-purple-300">Available Voice Channels</label>
            <div id="vcList" class="max-h-56 overflow-y-auto space-y-2 pr-1">
              <div class="text-center py-6 text-xs text-purple-400/50 italic">Select a server to view Voice Channels.</div>
            </div>
          </div>

          <!-- Bulk VC Join Trigger -->
          <button onclick="bulkJoinVC()" class="w-full py-3 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs purple-glow-btn transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-right-to-bracket"></i> 1-CLICK BULK JOIN VC
          </button>
        </div>
      </section>

      <!-- RIGHT COLUMN: AUDIO ENGINE & CONTROL PANEL -->
      <section class="lg:col-span-7 space-y-6">

        <!-- 2000% VOLUME & AUDIO BOOST CARD -->
        <div class="purple-glass rounded-2xl p-5 border border-purple-900/40 space-y-5">
          <div class="flex items-center justify-between border-b border-purple-900/40 pb-3">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-volume-high text-purple-400"></i> Volume Boost (Up to 2000%)
            </h2>
            <span id="volumeBadge" class="px-3 py-1 bg-purple-900/80 text-purple-300 border border-purple-500/40 font-mono text-sm font-bold rounded-full">
              200%
            </span>
          </div>

          <!-- Volume Slider -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs text-purple-300 font-semibold">
              <span>0% (Mute)</span>
              <span>100% (Normal)</span>
              <span>1000% (Boost)</span>
              <span class="text-purple-400 font-bold">2000% (MAX LOUD)</span>
            </div>
            <input type="range" id="volumeSlider" min="0" max="2000" value="200" oninput="updateVolume(this.value)" 
              class="w-full h-2 bg-purple-950 rounded-lg appearance-none cursor-pointer border border-purple-900">
          </div>

          <!-- Volume Presets -->
          <div class="grid grid-cols-4 gap-2">
            <button onclick="setVolumePreset(100)" class="py-1.5 bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-xs rounded-lg text-purple-300">100%</button>
            <button onclick="setVolumePreset(300)" class="py-1.5 bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-xs rounded-lg text-purple-300">300%</button>
            <button onclick="setVolumePreset(1000)" class="py-1.5 bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-xs rounded-lg text-purple-300">1000%</button>
            <button onclick="setVolumePreset(2000)" class="py-1.5 bg-gradient-to-r from-purple-800 to-indigo-700 hover:from-purple-700 hover:to-indigo-600 border border-purple-500 text-xs rounded-lg text-white font-bold">2000% MAX</button>
          </div>
        </div>

        <!-- VOICE FILTERS CARD -->
        <div class="purple-glass rounded-2xl p-5 border border-purple-900/40 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-sliders text-purple-400"></i> Voice & Audio Filters
          </h2>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button onclick="selectFilter('crispy')" id="filter-crispy" class="filter-btn purple-glass-hover border border-purple-800 p-3 rounded-xl text-center space-y-1 transition">
              <i class="fa-solid fa-sparkles text-purple-400 text-lg"></i>
              <div class="text-xs font-bold text-white">Crispy</div>
              <div class="text-[10px] text-purple-400/60">High Treble & Clear</div>
            </button>
            
            <button onclick="selectFilter('dry')" id="filter-dry" class="filter-btn purple-glass-hover border border-purple-800 p-3 rounded-xl text-center space-y-1 transition">
              <i class="fa-solid fa-droplet-slash text-purple-400 text-lg"></i>
              <div class="text-xs font-bold text-white">Dry</div>
              <div class="text-[10px] text-purple-400/60">Raw & No Reverb</div>
            </button>
            
            <button onclick="selectFilter('loud')" id="filter-loud" class="filter-btn purple-glass-hover border border-purple-800 p-3 rounded-xl text-center space-y-1 transition">
              <i class="fa-solid fa-bullhorn text-purple-400 text-lg"></i>
              <div class="text-xs font-bold text-white">Loud / Earrape</div>
              <div class="text-[10px] text-purple-400/60">Extreme Gain</div>
            </button>
            
            <button onclick="selectFilter('bass')" id="filter-bass" class="filter-btn purple-glass-hover border border-purple-800 p-3 rounded-xl text-center space-y-1 transition">
              <i class="fa-solid fa-wave-square text-purple-400 text-lg"></i>
              <div class="text-xs font-bold text-white">Deep Bass</div>
              <div class="text-[10px] text-purple-400/60">Low Frequency Boost</div>
            </button>
          </div>
        </div>

        <!-- MEDIA PLAYER & SOURCE CARD -->
        <div class="purple-glass rounded-2xl p-5 border border-purple-900/40 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-music text-purple-400"></i> Media & Audio Player
          </h2>

          <!-- Tab Selection -->
          <div class="flex border-b border-purple-900/60 text-xs font-semibold">
            <button onclick="switchMediaTab('file')" id="tabFileBtn" class="px-4 py-2 border-b-2 border-purple-500 text-purple-300">Upload File</button>
            <button onclick="switchMediaTab('url')" id="tabUrlBtn" class="px-4 py-2 border-b-2 border-transparent text-purple-400/60 hover:text-purple-300">YouTube / Stream URL</button>
          </div>

          <!-- File Upload Tab -->
          <div id="mediaTabFile" class="space-y-3">
            <div class="border-2 border-dashed border-purple-800/80 hover:border-purple-500 rounded-xl p-4 text-center bg-black/30 transition cursor-pointer" onclick="document.getElementById('audioFileInput').click()">
              <i class="fa-solid fa-file-audio text-2xl text-purple-400 mb-1"></i>
              <p class="text-xs text-purple-200">Click to add MP3, WAV or Audio File</p>
              <span id="selectedFileName" class="text-[11px] text-purple-400/70 block mt-1">No file chosen</span>
              <input type="file" id="audioFileInput" accept="audio/*" class="hidden" onchange="onFileSelected(event)">
            </div>
          </div>

          <!-- URL Tab -->
          <div id="mediaTabUrl" class="space-y-3 hidden">
            <input type="text" id="youtubeUrlInput" placeholder="Paste YouTube Link or Audio Stream URL (e.g. https://youtu.be/...)" 
              class="w-full bg-black/50 border border-purple-900 focus:border-purple-500 rounded-xl px-3 py-2 text-xs outline-none text-purple-200">
          </div>

          <!-- Audio Controls -->
          <div class="flex items-center gap-3 pt-2">
            <button onclick="playAudio()" class="flex-1 py-2.5 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-bold transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-play"></i> STREAM TO VC
            </button>
            <button onclick="stopAudio()" class="px-4 py-2.5 bg-red-950/80 hover:bg-red-900 text-red-200 border border-red-800 rounded-xl text-xs font-bold transition">
              <i class="fa-solid fa-stop"></i> STOP
            </button>
          </div>

          <!-- Live Status Output -->
          <div class="bg-black/80 rounded-xl p-3 border border-purple-950 font-mono text-xs space-y-1">
            <div class="text-purple-400/70 text-[10px] uppercase font-bold">Console Output:</div>
            <div id="consoleLog" class="text-purple-300 h-16 overflow-y-auto">
              [System Initialized] Dashboard Ready. Login as DINESH or HUKUM.
            </div>
          </div>
        </div>

      </section>
    </main>

    <!-- FOOTER -->
    <footer class="purple-glass border-t border-purple-900/40 py-3 px-6 text-center text-xs text-purple-400/60">
      Self-Bot Voice Control Panel &bull; Made for DINESH & HUKUM
    </footer>
  </div>

  <!-- BULK TOKEN MODAL -->
  <div id="bulkModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 hidden">
    <div class="purple-glass purple-glow w-full max-w-lg p-6 rounded-2xl border border-purple-500/30 space-y-4">
      <div class="flex justify-between items-center border-b border-purple-900/50 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-list-check text-purple-400"></i> Bulk Token Import
        </h3>
        <button onclick="toggleBulkModal()" class="text-purple-400 hover:text-white text-lg">&times;</button>
      </div>

      <p class="text-xs text-purple-300">Paste multiple tokens (one token per line):</p>
      
      <textarea id="bulkTokenTextarea" rows="6" placeholder="OTM2OT...&#10;MTg0ND...&#10;MTA1Mg..." 
        class="w-full bg-black/60 border border-purple-900 focus:border-purple-500 rounded-xl p-3 text-xs font-mono text-purple-200 outline-none"></textarea>

      <div class="flex justify-end gap-3">
        <button onclick="toggleBulkModal()" class="px-4 py-2 bg-purple-950 hover:bg-purple-900 text-purple-300 rounded-xl text-xs">Cancel</button>
        <button onclick="importBulkTokens()" class="px-5 py-2 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition">Import Tokens</button>
      </div>
    </div>
  </div>

  <script>
    let currentUser = null;
    let tokens = [];
    let selectedServer = "";
    let selectedVc = "";
    let currentFilter = "crispy";
    let selectedFile = null;

    const channelsByServer = {
      s1: ["🔊 Main Lounge VC", "🎮 Gaming Lobby", "🎶 24/7 Music VC"],
      s2: ["🎙️ Chill & Chat", "🔥 Earrape Test VC", "🎧 Squad 1"],
      s3: ["🎵 DJ Night 1", "🎵 Bass Boost VC 2"]
    };

    function handleLogin(e) {
      e.preventDefault();
      const user = document.getElementById('usernameInput').value.trim();
      const pass = document.getElementById('passwordInput').value.trim();
      const errEl = document.getElementById('loginError');

      if (user === 'DINESH' && pass === 'DINESH') {
        currentUser = { name: 'DINESH', role: 'User' };
      } else if (user === 'HUKUM' && pass === 'HUKUM1433') {
        currentUser = { name: 'HUKUM', role: 'Admin' };
      } else {
        errEl.classList.remove('hidden');
        return;
      }

      errEl.classList.add('hidden');
      document.getElementById('loginModal').classList.add('hidden');
      document.getElementById('appContainer').classList.remove('hidden');
      document.getElementById('appContainer').classList.add('flex');

      document.getElementById('currentUserDisplay').innerText = currentUser.name;
      document.getElementById('currentRoleDisplay').innerText = currentUser.role + " Account";

      if (currentUser.role === 'Admin') {
        document.getElementById('adminBanner').classList.remove('hidden');
      } else {
        document.getElementById('adminBanner').classList.add('hidden');
      }

      renderTokens();
      logConsole(`Welcome ${currentUser.name}! Dashboard active.`);
    }

    function handleLogout() {
      currentUser = null;
      document.getElementById('appContainer').classList.add('hidden');
      document.getElementById('appContainer').classList.remove('flex');
      document.getElementById('loginModal').classList.remove('hidden');
    }

    function renderTokens() {
      const listEl = document.getElementById('tokenList');
      document.getElementById('tokenCount').innerText = tokens.length;

      if (tokens.length === 0) {
        listEl.innerHTML = `<div class="text-center py-6 text-xs text-purple-400/50 italic">No tokens added yet. Paste tokens above.</div>`;
        return;
      }

      listEl.innerHTML = tokens.map(t => `
        <div class="flex items-center justify-between p-2.5 bg-black/40 border border-purple-950 rounded-xl">
          <div class="flex items-center gap-2 overflow-hidden">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="font-mono text-xs text-purple-200 truncate w-48">${t.token}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] bg-purple-900/60 text-purple-300 px-2 py-0.5 rounded">${t.status}</span>
            <button onclick="removeToken(${t.id})" class="text-purple-400 hover:text-red-400 text-xs"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>
      `).join('');
    }

    function addSingleToken() {
      const input = document.getElementById('singleTokenInput');
      const val = input.value.trim();
      if(!val) return;
      tokens.push({ id: Date.now(), token: val, status: "Ready" });
      input.value = "";
      renderTokens();
      logConsole("New bot token added to dashboard.");
    }

    function removeToken(id) {
      tokens = tokens.filter(t => t.id !== id);
      renderTokens();
      logConsole("Token removed from list.");
    }

    function toggleBulkModal() {
      const modal = document.getElementById('bulkModal');
      modal.classList.toggle('hidden');
    }

    function importBulkTokens() {
      const val = document.getElementById('bulkTokenTextarea').value;
      const lines = val.split('\n').map(l => l.trim()).filter(l => l.length > 0);
      lines.forEach(l => {
        tokens.push({ id: Date.now() + Math.random(), token: l, status: "Ready" });
      });
      document.getElementById('bulkTokenTextarea').value = "";
      toggleBulkModal();
      renderTokens();
      logConsole(`Bulk imported ${lines.length} tokens successfully.`);
    }

    function onServerChange() {
      const sVal = document.getElementById('serverSelect').value;
      const vcListEl = document.getElementById('vcList');
      selectedServer = sVal;

      if(!sVal || !channelsByServer[sVal]) {
        vcListEl.innerHTML = `<div class="text-center py-6 text-xs text-purple-400/50 italic">Select a server to view Voice Channels.</div>`;
        return;
      }

      const vcs = channelsByServer[sVal];
      vcListEl.innerHTML = vcs.map((vc, idx) => `
        <label class="flex items-center justify-between p-2.5 bg-black/40 hover:bg-purple-950/50 border border-purple-950 rounded-xl cursor-pointer">
          <span class="text-xs text-purple-200">${vc}</span>
          <input type="radio" name="vcChoice" value="${vc}" onchange="selectedVc='${vc}'" ${idx === 0 ? 'checked' : ''} class="accent-purple-500">
        </label>
      `).join('');
      selectedVc = vcs[0];
    }

    function bulkJoinVC() {
      if(tokens.length === 0) {
        alert("Please add at least one bot token first!");
        return;
      }
      if(!selectedServer || !selectedVc) {
        alert("Please select a Server and Voice Channel!");
        return;
      }
      logConsole(`⚡ [BULK JOIN] Connecting ${tokens.length} tokens to VC: ${selectedVc}...`);
      setTimeout(() => {
        logConsole(`✅ SUCCESS: All ${tokens.length} bots joined voice channel: ${selectedVc}`);
      }, 800);
    }

    function updateVolume(val) {
      document.getElementById('volumeBadge').innerText = val + "%";
      logConsole(`Volume updated to: ${val}%`);
    }

    function setVolumePreset(val) {
      document.getElementById('volumeSlider').value = val;
      updateVolume(val);
    }

    function selectFilter(filterKey) {
      currentFilter = filterKey;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('border-purple-400', 'bg-purple-900/40');
      });
      const activeBtn = document.getElementById(`filter-${filterKey}`);
      if(activeBtn) {
        activeBtn.classList.add('border-purple-400', 'bg-purple-900/40');
      }
      logConsole(`Voice Filter set to: [${filterKey.toUpperCase()}]`);
    }

    function switchMediaTab(tab) {
      const fileTab = document.getElementById('mediaTabFile');
      const urlTab = document.getElementById('mediaTabUrl');
      const fileBtn = document.getElementById('tabFileBtn');
      const urlBtn = document.getElementById('tabUrlBtn');

      if (tab === 'file') {
        fileTab.classList.remove('hidden');
        urlTab.classList.add('hidden');
        fileBtn.classList.add('border-purple-500', 'text-purple-300');
        fileBtn.classList.remove('border-transparent', 'text-purple-400/60');
        urlBtn.classList.remove('border-purple-500', 'text-purple-300');
        urlBtn.classList.add('border-transparent', 'text-purple-400/60');
      } else {
        urlTab.classList.remove('hidden');
        fileTab.classList.add('hidden');
        urlBtn.classList.add('border-purple-500', 'text-purple-300');
        urlBtn.classList.remove('border-transparent', 'text-purple-400/60');
        fileBtn.classList.remove('border-purple-500', 'text-purple-300');
        fileBtn.classList.add('border-transparent', 'text-purple-400/60');
      }
    }

    function onFileSelected(e) {
      if(e.target.files.length > 0) {
        selectedFile = e.target.files[0].name;
        document.getElementById('selectedFileName').innerText = "Selected: " + selectedFile;
        logConsole(`Music file loaded: ${selectedFile}`);
      }
    }

    function playAudio() {
      const ytUrl = document.getElementById('youtubeUrlInput').value.trim();
      const vol = document.getElementById('volumeSlider').value;
      let sourceInfo = selectedFile ? `File: ${selectedFile}` : (ytUrl ? `URL: ${ytUrl}` : "No Audio File/URL provided");

      logConsole(`▶️ Streaming to VC (${sourceInfo}) | Vol: ${vol}% | Filter: ${currentFilter}`);
    }

    function stopAudio() {
      logConsole(`⏹ Stopped playback across connected voice channels.`);
    }

    function logConsole(msg) {
      const c = document.getElementById('consoleLog');
      const time = new Date().toLocaleTimeString();
      c.innerHTML += `<div class="py-0.5"><span class="text-purple-500">[${time}]</span> ${msg}</div>`;
      c.scrollTop = c.scrollHeight;
    }

    selectFilter('crispy');
  </script>
</body>
</html>
